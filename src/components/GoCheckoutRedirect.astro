---
interface Props {
  destination: string;
  linkLabel?: string;
}

const { destination, linkLabel = 'Continue to checkout' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Redirecting to checkout…</title>
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={destination} />
    <script is:inline define:vars={{ destination }}>
      location.replace(destination);
    </script>
  </head>
  <body>
    <noscript>
      <p>
        <a href={destination} rel="noopener noreferrer">{linkLabel}</a>
      </p>
    </noscript>
  </body>
</html>
