---
import { t } from '../i18n';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';

const hub = t.seoTopics;
---

<section
  id="dota-hacks-topics"
  class="border-y border-border bg-background py-14 md:py-20"
  aria-labelledby="dota-hacks-topics-title"
>
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      eyebrow={hub.eyebrow}
      title={hub.title}
      desc={hub.lead}
      titleId="dota-hacks-topics-title"
    />

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        hub.cards.map((card) => (
          <li>
            <a
              href={card.href}
              class="group flex h-full flex-col rounded-2xl border border-border bg-card/60 p-5 shadow-sm transition-colors hover:border-primary/40 hover:bg-card"
            >
              <h3 class="text-base font-semibold leading-snug text-foreground group-hover:text-primary">
                {card.title}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{card.description}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wide text-primary">
                Read more
                <Icon name="arrowRight" size={14} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
