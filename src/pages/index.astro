---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import HomeTopicHub from '../components/HomeTopicHub.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import {
  dotaHacksServiceSchema,
  faqPageSchema,
  itemListSchema,
  organizationSchema,
  webPageSchema,
  websiteSchema,
} from '../utils/schema';
import { getLandingFaqs } from '../data/faq';
import { webpSrc } from '../utils/responsiveImage';
import { ROUTES, blogPostPath } from '../utils/path';
import { getFeaturedBlogPosts } from '../data/blog';

const seo = resolvePageSeo('/');
const homeFaqs = getLandingFaqs();
const heroLcpImage = webpSrc('/images/gameplay/dota-2-map-hack.png', 512);
const featuredGuides = getFeaturedBlogPosts(3);
const homeMoneyPages = [
  { name: 'Dota 2 Elite hacks', url: ROUTES.productsElite },
  { name: 'Dota 2 products & utilities', url: ROUTES.products },
  { name: 'Dota 2 hacks guides', url: ROUTES.blog },
  ...featuredGuides.map((post) => ({ name: post.title, url: blogPostPath(post.slug) })),
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    websiteSchema(),
    organizationSchema(),
    webPageSchema({
      name: seo.title,
      description: seo.description,
      url: '/',
      primaryImage: '/images/gameplay/dota-2-map-hack.png',
    }),
    dotaHacksServiceSchema(),
    itemListSchema(homeMoneyPages),
    faqPageSchema(homeFaqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') }))),
  ]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <HeroSection />
  <FeaturesSection />
  <HomeTopicHub />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
</BaseLayout>
